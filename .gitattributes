# Giữ LF trong working copy để SHA-256 của MANIFEST luôn verify được trên Windows.
* text=auto eol=lf

*.png binary
*.xlsx binary
*.ttf binary

# PowerShell 5.1 doc .ps1 theo ANSI neu khong co BOM, nen 2 file .ps1 duoc luu kem BOM
# (BOM la noi dung file, Git giu nguyen). CRLF cho dung quy uoc PowerShell tren Windows.
*.ps1 text eol=crlf
